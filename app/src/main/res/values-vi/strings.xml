    <string name="welcome_title">Chào mừng đến với Open Launcher</string><string name="welcome_description">Bảng điều khiển ngang hiện đại, gọn gàng, được thiết kế làm người bạn đồng hành tối ưu cho màn hình ô tô.</string><string name="offline_title">Hoạt động ngoại tuyến 100%</string><string name="offline_description">Không phụ thuộc vào sóng di động hay kết nối mạng. Đồng hồ tốc độ, la bàn và cao độ kế đều hoạt động hoàn toàn ngoại tuyến.</string><string name="customizable_title">Bảng điều khiển tùy biến cao</string><string name="customizable_description">Tùy chỉnh màu nhấn, nền chuyển sắc, phông chữ, hệ đơn vị và kéo thả để sắp xếp lại các ô.</string><string name="media_shortcuts_title">Bảng âm thanh &amp; lối tắt phương tiện</string><string name="media_shortcuts_description">Phát hiệu ứng âm thanh tùy chỉnh, quản lý lối tắt CarPlay và Android Auto, đồng thời điều khiển trình phát phương tiện đang hoạt động.</string>
    <string name="telemetry_weather_title">Dữ liệu hành trình &amp; thời tiết</string><string name="telemetry_weather_description">Để tính tốc độ, hướng la bàn, cao độ theo thời gian thực và cập nhật thời tiết địa phương, Open Launcher cần dịch vụ GPS có độ chính xác cao.</string><string name="permission_granted">Đã cấp quyền</string><string name="permission_required">Cần cấp quyền</string><string name="gps_ready">Dữ liệu GPS đã hoạt động và sẵn sàng.</string><string name="telemetry_disabled">Dữ liệu hành trình hiện đang bị tắt.</string><string name="grant_access">Cấp quyền truy cập</string>
    <string name="media_integration_title">Tích hợp phương tiện</string><string name="media_integration_description">Để hiển thị ảnh bìa, thông tin bài hát, thanh tiến trình và điều khiển phát trên bảng điều khiển, Open Launcher sẽ đọc thông báo phương tiện đang hoạt động.</string><string name="notification_access_granted">Đã cấp quyền truy cập thông báo</string><string name="notification_access_required">Cần quyền truy cập thông báo</string><string name="music_widget_connected">Tiện ích phát nhạc đã kết nối.</string><string name="now_playing_inactive">Bảng Đang phát sẽ không hoạt động.</string><string name="enable_media_listener">Bật trình nghe phương tiện</string><string name="ready_for_road">Sẵn sàng lên đường!</string><string name="ready_description">Mọi thứ đã được thiết lập. Bạn có thể đặt Open Launcher làm ứng dụng màn hình chính mặc định để tự động mở khi khởi động xe.</string><string name="set_as_default">Đặt làm mặc định</string>
<string name="set_default_launcher">Đặt làm launcher mặc định</string><string name="default_launcher_active">Đang hoạt động - Open Launcher là ứng dụng màn hình chính</string><string name="default_launcher_required">Cần thiết để đầu màn hình khởi động vào Open Launcher</string><string name="notification_access">Truy cập thông báo</string><string name="notification_granted">Đã cấp - điều khiển phương tiện đang hoạt động</string><string name="notification_required">Cần thiết cho tiện ích Đang phát</string><string name="draw_over_apps">Hiển thị trên ứng dụng khác</string><string name="overlay_granted">Đã cấp - lớp phủ PIP đang bật</string><string name="overlay_required">Cần thiết cho cửa sổ nổi PIP</string><string name="location_access">Truy cập vị trí</string><string name="location_granted">Đã cấp - GPS, la bàn và thời tiết đang hoạt động</string><string name="location_required">Cần thiết cho la bàn, tốc độ và thời tiết</string>
