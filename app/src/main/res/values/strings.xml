    <string name="welcome_title">Welcome to Open Launcher</string>
    <string name="welcome_description">A clean, modern landscape dashboard designed to be the ultimate companion for your car\'s screen.</string>
    <string name="offline_title">100% Offline-Based</string>
    <string name="offline_description">No reliance on a mobile signal or network connection to function. Speedometer, compass telemetry, and altimeter operate entirely offline.</string>
    <string name="customizable_title">Highly Customizable Dashboard</string>
    <string name="customizable_description">Tailor color accents, background gradients, typography fonts, system units, and drag-and-drop to rearrange your tiles.</string>
    <string name="media_shortcuts_title">Soundboard &amp; Media Shortcuts</string>
    <string name="media_shortcuts_description">Trigger custom soundboard sound effects, manage CarPlay &amp; Android Auto shortcuts, and control active media players.</string>
